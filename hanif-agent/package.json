{
  "name": "hanif-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal agent workflow CLI",
  "bin": {
    "hanif-agent": "./bin/hanif-agent.ts"
  },
  "scripts": {
    "hanif-agent": "bun run bin/hanif-agent.ts",
    "typecheck": "tsc --noEmit",
    "effect:diagnostics": "effect-language-service diagnostics --project tsconfig.json",
    "prepare": "effect-language-service patch",
    "test": "vitest run"
  },
  "dependencies": {
    "@effect/cli": "^0.77.0",
    "@effect/platform": "^0.97.1",
    "@effect/platform-bun": "^0.91.2",
    "@opencode-ai/sdk": "1.17.20",
    "effect": "^3.22.1"
  },
  "devDependencies": {
    "@effect/language-service": "^0.87.1",
    "@effect/vitest": "^0.30.0",
    "@types/bun": "^1.3.14",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  }
}
