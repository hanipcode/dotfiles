{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "allow",
    "edit": {
      "*": "allow",
      "*eslint.config.*": "ask",
      "*.eslintrc*": "ask",
      "*.eslintignore": "ask",
      "*biome.json": "ask",
      "*biome.jsonc": "ask",
      "*.oxlintrc.json": "ask",
      "*oxlint.config.*": "ask"
    }
  },
  "references": {
    "effect": {
      "repository": "Effect-TS/effect",
      "branch": "main",
      "description": "Use for Effect V4 API signatures, source, tests, and current examples whenever Effect code changes."
    }
  },
  "provider": {
    "openai": {
      "options": {
        "headerTimeout": 60000
      }
    }
  },
  "mcp": {
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "enabled": true
    },
    "posthog": {
      "type": "remote",
      "url": "https://mcp.posthog.com/mcp?mode=cli&project_id=505977",
      "enabled": true,
      "timeout": 30000
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
      "enabled": true
    }
  }
}
