{
  "$schema": "https://opencode.ai/config.json",
  "permission": "allow",
  "plugin": [
    "opencode-fungsi-galaksi",
    "opencode-openai-codex-auth",
    "opencode-gemini-auth",
    "opencode-anthropic-auth",
    "@byfungsi/opencode-sumopod-plugin"
  ],
  "provider": {
    "openai": {
      "options": {
        "headerTimeout": 60000
      }
    }
  },
  "mcp": {
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "enabled": true
    },
    "posthog": {
      "type": "remote",
      "url": "https://mcp.posthog.com/mcp?mode=cli&project_id=505977",
      "enabled": true,
      "timeout": 30000
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
      "enabled": true
    }
  }
}
