  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/hanifmuhammad/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bunx -y ccstatusline@latest",
    "padding": 0
  },
  "enabledPlugins": {
    "figma@claude-plugins-official": true,
    "slack@claude-plugins-official": true,
    "atlassian@claude-plugins-official": true
  },
  "tui": "default",
  "feedbackSurveyState": {
    "lastShownTime": 1754036707243
  },
  "skipDangerousModePermissionPrompt": true
