#!/usr/bin/env bash

set -euo pipefail

for dependency in git fzf diffdash; do
  if ! command -v "$dependency" >/dev/null 2>&1; then
    printf 'dilw: required command not found: %s\n' "$dependency" >&2
    exit 1
  fi
done

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  printf 'dilw: current directory is not inside a Git worktree\n' >&2
  exit 1
fi

if ! git rev-parse --verify --quiet HEAD^ >/dev/null; then
  printf 'dilw: HEAD has no earlier commit to compare\n' >&2
  exit 1
fi

selected=$(
  git log --skip=1 --format='%H%x09%C(auto)%h%C(reset) %s' HEAD |
    fzf --ansi --delimiter=$'\t' --with-nth=2.. --prompt='Compare HEAD with commit: '
) || exit 0

if [[ -z $selected ]]; then
  exit 0
fi

selected_commit=${selected%%$'\t'*}
exec diffdash diff "$selected_commit"
