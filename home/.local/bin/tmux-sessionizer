#!/usr/bin/env bash

if [[ $# -eq 1 ]]; then
    selected=$1
else
    # ~/.dotfiles is named explicitly rather than added as a root: find lists the
    # CHILDREN of a root, and the repo root itself is what we want to open.
    selected=$( { find ~/Projects ~/.config -mindepth 1 -maxdepth 1 -type d
                  echo "$HOME/.dotfiles"; } | fzf)
fi

if [[ -z $selected ]]; then
    exit 0
fi

# <parent>_<dir> so ~/.config/nvim and ~/Projects/nvim stay distinguishable.
# Directories directly under $HOME skip the parent segment, which would otherwise
# be the username (~/.dotfiles -> hanifmuhammad__dotfiles).
if [[ $(dirname "$selected") == "$HOME" ]]; then
    selected_name=$(basename "$selected")
else
    selected_name=$(basename "$(dirname "$selected")")_$(basename "$selected")
fi
selected_name=$(echo "$selected_name" | tr '.:' '__')
tmux_running=$(pgrep tmux)

if [[ -z $TMUX ]] && [[ -z $tmux_running ]]; then
    tmux new-session -s "$selected_name" -c "$selected"
    exit 0
fi

if ! tmux has-session -t="$selected_name" 2> /dev/null; then
    tmux new-session -ds "$selected_name" -c "$selected"
fi

tmux switch-client -t "$selected_name"
