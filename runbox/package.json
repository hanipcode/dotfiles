{
  "name": "runbox",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A Git-aware runner for agent worktrees",
  "bin": {
    "runbox": "./bin/runbox.tsx"
  },
  "scripts": {
    "runbox": "bun run bin/runbox.tsx",
    "typecheck": "tsc --noEmit",
    "effect:diagnostics": "effect-language-service diagnostics --project tsconfig.json",
    "prepare": "effect-language-service patch",
    "test": "vitest run --maxWorkers=1 --minWorkers=1 && bun test ./tests/Dashboard.bun.tsx ./tests/GlobalDashboard.bun.tsx",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@effect/cli": "^0.77.0",
    "@effect/platform": "^0.97.1",
    "@effect/platform-bun": "^0.91.2",
    "@effect/printer": "^0.51.0",
    "@effect/printer-ansi": "^0.51.0",
    "@opentui/core": "^0.5.1",
    "@opentui/react": "^0.5.1",
    "@parcel/watcher": "^2.6.0",
    "effect": "^3.22.1",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@effect/language-service": "^0.87.1",
    "@effect/vitest": "^0.30.0",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  }
}
