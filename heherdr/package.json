{
  "name": "heherdr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Framework and plugins for herdr — modal (vim-style) terminal UIs on OpenTUI + React + Effect",
  "bin": {
    "heherdr": "./bin/heherdr.ts"
  },
  "scripts": {
    "heherdr": "bun run bin/heherdr.ts",
    "typecheck": "tsc --noEmit",
    "link:herdr": "herdr plugin unlink heherdr || true && herdr plugin link .",
    "test": "bun test"
  },
  "dependencies": {
    "@effect-atom/atom": "^0.5.3",
    "@effect-atom/atom-react": "^0.5.0",
    "@effect/cli": "^0.77.0",
    "@effect/platform": "^0.97.1",
    "@effect/platform-bun": "^0.91.2",
    "@effect/printer": "^0.51.0",
    "@effect/printer-ansi": "^0.51.0",
    "@opentui/core": "^0.5.1",
    "@opentui/react": "^0.5.1",
    "effect": "^3.22.1",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.0",
    "typescript": "^5.7.0"
  }
}
